# Конфигурация сервиса доменной авторизации
# Скопируйте в .env и заполните значениями вашей инфраструктуры

# Порт auth-сервиса
AUTH_PORT=3002

# ============================================================
# Настройки LDAP/Active Directory
# ============================================================

# URL контроллера домена (LDAP)
# Для LDAPS (SSL): ldaps://dc01.company.local:636
# Для LDAP: ldap://dc01.company.local:389
LDAP_URL=ldap://dc01.company.local:389

# Base DN для поиска пользователей
# Пример: DC=company,DC=local
LDAP_BASE_DN=DC=company,DC=local

# Service account для поиска пользователей (опционально)
# Если не указан — используется bind от имени самого пользователя
# Формат: CN=reader,OU=Service,DC=company,DC=local
LDAP_BIND_DN=

# Пароль service account
LDAP_BIND_PASSWORD=

# Шаблон поиска пользователя
# {{username}} заменяется на введённое имя пользователя
LDAP_USER_SEARCH=(&(objectClass=user)(sAMAccountName={{username}}))

# Доменное имя (для NTLM и формирования UPN)
DOMAIN=COMPANY

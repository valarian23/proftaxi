# Конфигурация бэкенда
# Скопируйте этот файл в .env и заполните значениями

# Порт бэкенда (измените если 3001 занят)
PORT=5123

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=carpool
DB_USER=carpool_user
DB_PASSWORD=your_secure_password_here

# Домен (для NTLM-авторизации)
DOMAIN=YOUR_COMPANY_DOMAIN
